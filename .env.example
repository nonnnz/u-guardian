PORT=4173
# Connections persists keys and provider settings to .env. Never commit this file with real keys.
# Paste the U-bot Bearer token here only (the Bearer prefix is optional in the UI).
UBOT_TOKEN=
# Optional override. Leave blank to use the guarded U-bot template in providers.mjs.
UBOT_TEMPLATE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v2
AVALANCHE_DATA_API_KEY=
TOKENOMIST_API_KEY=
GUARDIAN_AGENT_MODE=ubot
PHONE_PORT=4175
# Optional carrier setup: npm run phone:connect imports this caller into ElevenLabs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# UBOT_TEMPLATE_BASE64 is generated by the app for JSON payloads. Never paste a token into it.
