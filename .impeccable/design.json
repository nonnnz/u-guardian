  "narrative": {
    "northStar": "The companion beside your wallet",
    "overview": "An approachable geometric robot sits within a calm daylight workspace. Warm ivory, forest ink and sage preserve the established identity; quiet space gives the mascot a recognizable presence while Thai explanations and evidence remain easy to read. This is descriptive language for the shipped world, not a separately approved concept.\n\nThe wallet is a quiet paper surface, while chat and settings use focused dialogs. The mascot lends personality to the entry point and pairs its expression with written operational status inside chat. Reusable visual decisions are recorded here; the single-page composition and interaction contract live in the surface brief.",
    "keyCharacteristics": [
      "Warm ivory surfaces with forest controls and sage emphasis.",
      "Thai-first interface text with restrained serif wordmarks.",
      "A geometric robot whose expression accompanies written status.",
      "Quiet dividers, expandable evidence and explicit review actions."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Operational state is expressed in text alongside mascot changes; color and expression do not carry the message alone.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep the wallet flat; use modal elevation for focused work and local shading for the character.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve warm ivory, forest and sage across wallet, chat and settings.",
      "Do pair mascot state with readable operational status.",
      "Do keep voice user initiated and preserve the text alternative.",
      "Do keep evidence and monitoring limits near the relevant action.",
      "Do keep close controls available while dialog content scrolls."
    ],
    "donts": [
      "Don't use the mascot's expression as a claim that a wallet is safe.",
      "Don't turn demo data, missing evidence or unavailable monitoring into certainty.",
      "Don't promote compact diagnostic typography into primary reading text.",
      "Don't reuse dormant welcome, launcher or multi-column styles as current design guidance."
    ]
  }
}
