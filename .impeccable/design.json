      "css": ".ds-label{display:block;font-family:\"Leelawadee UI\",Tahoma,sans-serif;font-size:14px;line-height:1.7;color:#203d34}.ds-field{display:block;width:100%;min-height:44px;background:#fffefa;color:#203d34;border:1px solid #b7c4ad;border-radius:7px;padding:10px;margin-top:6px;font:16px \"Leelawadee UI\",Tahoma,sans-serif;caret-color:#285946}.ds-field::placeholder{color:#687064}.ds-field:focus-visible{outline:3px solid #9a5635;outline-offset:4px}"
