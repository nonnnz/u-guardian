  "narrative": {
    "northStar": "The companion beside your wallet",
    "overview": "An approachable geometric robot sits within a calm daylight workspace. Warm ivory, forest ink and sage preserve the established identity; quiet space gives the mascot a recognizable presence while Thai explanations and evidence remain easy to read. This is descriptive language for the shipped world, not a separately approved concept.\n\nThe welcoming mascot becomes a small operational companion once a conversation begins. The existing connection and financial tools retain their denser field-journal layout at `settings.html`.",
    "keyCharacteristics": [
      "Warm ivory surfaces with forest controls and sage emphasis.",
      "Thai-first interface text with restrained serif wordmarks.",
      "A geometric robot whose expression accompanies written status.",
      "Quiet dividers, expandable evidence and explicit review actions."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Operational state is expressed in text alongside mascot changes; color and expression do not carry the message alone.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Preserve tonal separation for the companion panel; reserve the observed shadows for the character and collapsed launcher.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve warm ivory, forest and sage across host and companion surfaces.",
      "Do pair mascot state with readable operational status.",
      "Do keep voice user initiated and preserve the text alternative.",
      "Do keep evidence and monitoring limits near the relevant action.",
      "Do keep the mobile companion before the demo wallet."
    ],
    "donts": [
      "Don't use the mascot's expression as a claim that a wallet is safe.",
      "Don't turn demo data, missing evidence or unavailable monitoring into certainty.",
      "Don't replace the Shadow DOM boundary with host-dependent styling.",
      "Don't promote compact diagnostic typography into primary reading text."
    ]
  }
