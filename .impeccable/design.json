      "css": ".ds-wallet{font-family:\"Leelawadee UI\",Tahoma,sans-serif;background:#fffefa;color:#203d34;border:1px solid #dce1d1;border-radius:16px;padding:36px}.ds-wallet h2{font-size:24px;font-weight:500;margin:0 0 20px}.ds-asset{display:flex;justify-content:space-between;gap:24px;padding:20px 0;border-bottom:1px solid #dce1d1;font-size:16px}.ds-amount{font-variant-numeric:tabular-nums;font-size:18px}.ds-wallet p{font-size:13px;color:#59685f;line-height:1.7}"
