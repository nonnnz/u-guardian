      "name": "Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "Labeled text alternative to voice.",
      "html": "<label class=\"ds-label\" for=\"ds-question\">ถาม Guardian</label><div class=\"ds-composer\"><textarea class=\"ds-control ds-input\" id=\"ds-question\" rows=\"1\" placeholder=\"ถาม Guardian\"></textarea><button class=\"ds-control ds-send\" aria-label=\"ส่งข้อความ\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 5v15\"/></svg></button></div>",
      "css": ".ds-label{font-family:\"Leelawadee UI\",Tahoma,sans-serif;font-size:12px;color:#59685f}.ds-composer{display:flex;align-items:center;gap:10px;background:#f3f4ec;border-radius:12px;padding:9px 10px 9px 16px}.ds-input{font-family:\"Leelawadee UI\",Tahoma,sans-serif;resize:vertical;min-height:28px;max-height:120px;flex:1;min-width:0;border:0;background:transparent;color:#203d34;font-size:16px}.ds-send{background:var(--guardian-accent,#285946);color:#fffefa;border:0;border-radius:8px;width:37px;height:37px;cursor:pointer}.ds-send svg{width:21px;height:21px}.ds-send:hover{filter:brightness(.96)}.ds-control:focus-visible{outline:3px solid #9a5635;outline-offset:4px}.ds-control:disabled{opacity:.55;cursor:wait}"
    },
