      "description": "Shared surface with a small orange top accent and exact quantities.",
      "html": "<section class=\"ds-wallet\" aria-label=\"Wallet\"><h2>Your wallet</h2><div class=\"ds-holding\"><strong>AVAX</strong><span>12.5</span></div></section>",
      "css": ".ds-wallet{font-family:Manrope,\"Leelawadee UI\",Tahoma,sans-serif;position:relative;background:var(--surface,#1c1e25);color:#f5f1e9;border:1px solid #3b3b42;border-radius:24px;padding:40px 44px 28px;box-shadow:0 24px 64px #00000026}.ds-wallet:before{content:'';position:absolute;top:-1px;left:44px;width:52px;height:3px;background:var(--accent,#ff994d);border-radius:0 0 3px 3px}.ds-wallet h2{font-size:clamp(28px,3.5vw,40px);font-weight:550;line-height:1.25;letter-spacing:-1.5px;margin:0 0 30px}.ds-holding{display:flex;justify-content:space-between;gap:24px;padding:22px 0;border-block:1px solid var(--line,#34363d)}.ds-holding strong{font-size:16px;font-weight:650}.ds-holding span{font-size:25px;font-weight:550;letter-spacing:-.7px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Chat composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "Fixed bottom composer with icon microphone and circular orange send action.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-message-input\" aria-label=\"Ask Guardian\" placeholder=\"Ask Guardian anything…\" rows=\"2\"></textarea><div class=\"ds-tools\"><button class=\"ds-mic\" aria-label=\"Tap to speak\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"12\" rx=\"3\"/><path d=\"M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8\"/></svg></button><button class=\"ds-send\" aria-label=\"Send message\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"m5 12 7-7 7 7M12 5v15\"/></svg></button></div></div>",
      "css": ".ds-composer{font-family:Manrope,\"Leelawadee UI\",Tahoma,sans-serif;display:flex;flex-direction:column;gap:8px;padding:16px;background:#25272e;border:1px solid #575058;border-radius:18px}.ds-composer:focus-within{border-color:var(--accent,#ff994d)}.ds-message-input{font-family:Manrope,\"Leelawadee UI\",Tahoma,sans-serif;resize:none;width:100%;min-height:48px;max-height:112px;border:0;outline:none;background:transparent;color:#f5f1e9;font-size:15px;line-height:1.6;padding:0}.ds-message-input::placeholder{color:#a1a1ac}.ds-tools{display:flex;align-items:center;justify-content:flex-end;gap:8px}.ds-tools button{display:grid;place-items:center;cursor:pointer;border:0}.ds-tools button svg{width:21px;height:21px}.ds-mic{margin-right:auto;min-width:44px;min-height:44px;color:#dcd5cc;background:transparent;border-radius:10px}.ds-mic:hover{background:#3a3430}.ds-send{width:42px;height:42px;border-radius:50%;background:var(--accent,#ff994d);color:#211b16}.ds-send:hover{filter:brightness(1.1)}.ds-tools button:focus-visible{outline:2px solid #ffad70;outline-offset:4px}.ds-tools button:active{transform:translateY(1px)}"
